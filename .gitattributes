# Normalize line endings so the repo is clean across Windows/Linux (Cloud Run builds on Linux).
* text=auto eol=lf

# Windows-native scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat these as binary (no EOL munging, no diff)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.parquet binary
*.xlsx binary
*.pdf binary
