# ──────────────────────────────────────────────────────────────────────
# Google Cloud / Vertex AI
# ──────────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=     # path to service-account JSON
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro

# ──────────────────────────────────────────────────────────────────────
# MongoDB Atlas
# ──────────────────────────────────────────────────────────────────────
# Connection string from Atlas → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=
MONGODB_DATABASE=prism

# Collection names (these will be auto-created)
MONGODB_COLL_13F=filings_13f
MONGODB_COLL_FORM4=filings_form4
MONGODB_COLL_WSB=wsb_posts
MONGODB_COLL_PAPERS=papers
MONGODB_COLL_PRICES=prices
MONGODB_COLL_SIGNALS=normalized_signals
MONGODB_COLL_DIVERGENCE=divergence_library

# Atlas Vector Search index names
MONGODB_VECTOR_INDEX_WSB=wsb_posts_vector_idx
MONGODB_VECTOR_INDEX_PAPERS=papers_vector_idx
MONGODB_VECTOR_INDEX_DIVERGENCE=divergence_vector_idx

# ──────────────────────────────────────────────────────────────────────
# SEC EDGAR
# ──────────────────────────────────────────────────────────────────────
# Required — SEC requires a User-Agent identifying the requester.
# Format per SEC policy: "Your Name your@email.com"
SEC_USER_AGENT=

# ──────────────────────────────────────────────────────────────────────
# Reddit (PRAW)
# ──────────────────────────────────────────────────────────────────────
# Create an app at https://www.reddit.com/prefs/apps/ ("script" type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=prism/0.1 by u/your_username
# Optional — for OAuth-required endpoints
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# App config
# ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
INGEST_BATCH_SIZE=50
RATE_LIMIT_SEC_EDGAR=8        # SEC allows 10/sec, leave headroom
RATE_LIMIT_REDDIT=1           # PRAW handles this automatically
